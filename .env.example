# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/eventsphere_db
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=10

# Security & JWT Tokens
JWT_SECRET=
JWT_SHORT_EXPIRY=
JWT_LONG_EXPIRY=
JWT_REG_EXPIRY=

# Supabase S3 Storage
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_REGION=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET_NAME=

# File Upload Constraints (e.g., 10MB)
MULTIPART_FILE_MAX_SIZE=10MB
MULTIPART_REQUEST_MAX_SIZE=10MB
GLOBAL_FILE_MAX_SIZE=10MB

# Default System Administrator Account
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_PHONE=
ADMIN_DEFAULT_CNIC=
ADMIN_DEFAULT_PIC=

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379

# Mail Server Settings
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# Business Logic Configuration
OTP_EXPIRY=5
DISTANCE_RADIUS=100
